    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.7.0",
    "@fontsource-variable/anek-devanagari": "^5.3.0",
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
