# ---------- API (FastAPI, Vercel env vars) ----------
# Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Postgres connection string from Supabase > Connect > Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Only needed if the project still uses the legacy HS256 JWT secret (Settings > API > JWT secret).
# Leave empty when the project uses the new JWT signing keys (verified through JWKS).
SUPABASE_JWT_SECRET=
# Brand / tenant this deployment serves by default
DEFAULT_TENANT=vahanza

# Send-SMS auth hook (Supabase > Authentication > Hooks > Send SMS > HTTPS)
# Secret shown by Supabase when you create the hook, format: v1,whsec_xxx
SEND_SMS_HOOK_SECRET=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Set to 1 to log OTPs instead of sending (local development only)
SMS_DRY_RUN=1

# Vercel Blob for profile photos (Vercel > Storage > Blob > token). Leave empty locally:
# photos are then kept in a temp folder on your machine.
BLOB_READ_WRITE_TOKEN=

# ---------- Web (Vite, must start with VITE_) ----------
VITE_SUPABASE_URL=
# Supabase publishable (anon) key
VITE_SUPABASE_ANON_KEY=
# Leave empty on Vercel (same domain). For local dev: http://localhost:8000
VITE_API_URL=
VITE_BRAND=vahanza

# Push (Sprint 6). Web: python scripts/make_vapid_keys.py. APK: Firebase service-account JSON on one line.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.in
FCM_SERVICE_ACCOUNT=

# Bulk import invites (Sprint 7)
PUBLIC_APP_URL=
MSG91_INVITE_TEMPLATE_ID=

# Sprint 8: daily job (licence reminders, weekly profile views). Any long random text; also set it in Vercel.
CRON_SECRET=

# Sprint 11: MPIN login (API only, secret: Supabase > Project Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=

